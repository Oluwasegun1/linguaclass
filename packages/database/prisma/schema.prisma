// =============================================================================
// LinguaClass — Prisma Schema
// Database: PostgreSQL (Supabase)
// Generator: prisma-client-js
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ──────────────────────────────────────────────────

enum Role {
  TEACHER
  STUDENT
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AIStatus {
  SUGGESTED
  ACCEPTED
  EDITED
  DISMISSED
}

enum AssignmentType {
  WRITTEN
  FILE_UPLOAD
  AUDIO
  VIDEO
  QUIZ
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

enum VocabStatus {
  NEW
  LEARNING
  LEARNED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ── CORE MODELS ────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  // This links to Supabase Auth — same UUID from auth.users
  supabaseId    String    @unique
  email         String    @unique
  name          String
  role          Role
  timezone      String    @default("UTC")
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacherProfile  TeacherProfile?
  studentProfile  StudentProfile?
  guardianContact GuardianContact?  // if student is a minor

  @@map("users")
}

model TeacherProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  languages    String[] // ["French", "Spanish"]
  createdAt    DateTime @default(now())

  courses      Course[]
  invitations  StudentInvitation[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMinor      Boolean  @default(false)
  createdAt    DateTime @default(now())

  enrollments  Enrollment[]
  vocabulary   VocabularyItem[]
  progress     Progress[]
  submissions  Submission[]

  @@map("student_profiles")
}

model GuardianContact {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  createdAt    DateTime @default(now())

  @@map("guardian_contacts")
}

// ── COURSES & LESSONS ──────────────────────────────────────

model Course {
  id          String      @id @default(uuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  title       String
  language    String      // "French"
  level       CourseLevel
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  enrollments Enrollment[]
  lessons     Lesson[]
  resources   Resource[]
  invitations StudentInvitation[]

  @@map("courses")
}

model Enrollment {
  id               String         @id @default(uuid())
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id])
  studentProfileId String
  student          StudentProfile @relation(fields: [studentProfileId], references: [id])
  enrolledAt       DateTime       @default(now())

  @@unique([courseId, studentProfileId])
  @@map("enrollments")
}

model StudentInvitation {
  id          String           @id @default(uuid())
  email       String
  token       String           @unique
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([email])
  @@index([token])
  @@map("student_invitations")
}

model Lesson {
  id           String        @id @default(uuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id])
  title        String
  scheduledAt  DateTime
  durationMins Int           @default(60)
  timezone     String        @default("UTC")
  objectives   String?
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  session      Session?
  resources    Resource[]
  assignments  Assignment[]
  notes        Note[]

  @@map("lessons")
}

// ── SESSION (the live event) ───────────────────────────────

model Session {
  id           String        @id @default(uuid())
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id])
  startedAt    DateTime?
  endedAt      DateTime?
  durationSecs Int?
  status       SessionStatus @default(SCHEDULED)
  videoRoomId  String?       // Daily.co / LiveKit room ID
  createdAt    DateTime      @default(now())

  transcript   Transcript?
  recording    Recording?
  chatMessages ChatMessage[]
  consentRecords ConsentRecord[]
  aiAnalysis   AIAnalysis?

  @@map("sessions")
}

model ConsentRecord {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  userId      String
  consented   Boolean
  consentedAt DateTime @default(now())
  // Recording can never exist without a ConsentRecord — enforced at app layer

  @@unique([sessionId, userId])
  @@map("consent_records")
}

model Recording {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  session      Session  @relation(fields: [sessionId], references: [id])
  storageKey   String   // path in Supabase Storage
  durationSecs Int?
  sizeBytes    BigInt?
  expiresAt    DateTime? // retention policy
  createdAt    DateTime @default(now())

  @@map("recordings")
}

// ── TRANSCRIPT ─────────────────────────────────────────────

model Transcript {
  id          String    @id @default(uuid())
  sessionId   String    @unique
  session     Session   @relation(fields: [sessionId], references: [id])
  language    String    // "fr"
  status      String    @default("pending") // pending | processing | done | failed
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  segments    TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String     @id @default(uuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  speakerId    String     // userId
  speakerRole  Role
  startMs      Int        // milliseconds from session start
  endMs        Int
  text         String
  confidence   Float?
  createdAt    DateTime   @default(now())

  @@map("transcript_segments")
}

// ── AI ANALYSIS ────────────────────────────────────────────

model AIAnalysis {
  id               String    @id @default(uuid())
  sessionId        String    @unique
  session          Session   @relation(fields: [sessionId], references: [id])
  analysisStatus   AIStatus  @default(SUGGESTED)

  // Provenance
  model            String    @default("gemini")
  modelVersion     String    // e.g. "gemini-2.0-flash"
  sourceTranscript String?   // the raw text transcript that was analyzed

  // Legacy flat fields (kept for backwards compatibility)
  summaryText      String?
  topicsCovered    String[]

  // Full structured Lesson Intelligence payload (validated JSON)
  payload          Json?

  processedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reviewedAt       DateTime?

  vocabularyItems VocabularyItem[]   // extracted items, pending teacher review
  corrections     GrammarCorrection[]

  @@index([sessionId])
  @@map("ai_analyses")
}

model GrammarCorrection {
  id           String   @id @default(uuid())
  aiAnalysisId String
  aiAnalysis   AIAnalysis @relation(fields: [aiAnalysisId], references: [id])
  studentId    String   // userId of student who made the error
  original     String   // what the student said
  corrected    String   // AI suggestion
  explanation  String
  segmentId    String?  // link back to the transcript segment
  status       AIStatus @default(SUGGESTED)
  teacherNote  String?  // if teacher edits before accepting
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@map("grammar_corrections")
}

// ── VOCABULARY ─────────────────────────────────────────────

model VocabularyItem {
  id               String         @id @default(uuid())
  studentProfileId String
  student          StudentProfile @relation(fields: [studentProfileId], references: [id])
  aiAnalysisId     String?
  aiAnalysis       AIAnalysis?    @relation(fields: [aiAnalysisId], references: [id])
  word             String
  translation      String
  exampleSentence  String?
  language         String         // "fr"
  status           VocabStatus    @default(NEW)
  aiStatus         AIStatus       @default(SUGGESTED) // teacher must accept
  isFavourited     Boolean        @default(false)
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@map("vocabulary_items")
}

// ── RESOURCES ──────────────────────────────────────────────

model Resource {
  id          String   @id @default(uuid())
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
  uploadedBy  String   // userId
  fileName    String
  fileType    String   // "pdf" | "docx" | "image" | "audio" | "video" | "link"
  storageKey  String?  // path in Supabase Storage
  url         String?  // for link-type resources
  sizeBytes   BigInt?
  createdAt   DateTime @default(now())

  @@map("resources")
}

// ── NOTES ──────────────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  authorId  String   // userId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

// ── CHAT ───────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  senderId  String   // userId
  content   String
  sentAt    DateTime @default(now())

  @@map("chat_messages")
}

// ── ASSIGNMENTS ────────────────────────────────────────────

model Assignment {
  id          String         @id @default(uuid())
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id])
  title       String
  description String
  type        AssignmentType
  dueAt       DateTime?
  createdAt   DateTime       @default(now())

  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id               String           @id @default(uuid())
  assignmentId     String
  assignment       Assignment       @relation(fields: [assignmentId], references: [id])
  studentProfileId String
  student          StudentProfile   @relation(fields: [studentProfileId], references: [id])
  content          String?          // written response
  storageKey       String?          // file/audio/video upload
  status           SubmissionStatus @default(DRAFT)
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())

  feedback         Feedback?

  @@unique([assignmentId, studentProfileId])
  @@map("submissions")
}

model Feedback {
  id            String     @id @default(uuid())
  submissionId  String     @unique
  submission    Submission @relation(fields: [submissionId], references: [id])
  teacherId     String     // userId
  score         Int?       // nullable — not every assignment is scored
  strengths     String?
  improvements  String?
  teacherNote   String?
  aiDraft       String?    // AI-generated draft, only teacher sees this
  publishedAt   DateTime?  // null until teacher publishes to student
  createdAt     DateTime   @default(now())

  @@map("feedback")
}

// ── PROGRESS ───────────────────────────────────────────────

model Progress {
  id               String         @id @default(uuid())
  studentProfileId String
  student          StudentProfile @relation(fields: [studentProfileId], references: [id])
  courseId         String
  vocabulary       Int            @default(0) // items learned
  grammarScore     Int            @default(0) // 0–100
  speakingScore    Int            @default(0)
  writingScore     Int            @default(0)
  listeningScore   Int            @default(0)
  readingScore     Int            @default(0)
  lessonsAttended  Int            @default(0)
  assignmentsDone  Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, courseId])
  @@map("progress")
}
